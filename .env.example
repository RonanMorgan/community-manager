# =============================================================================
# community-manager — environment variables
# =============================================================================

# --- Mattermost (source of truth for channels / memberships) ---
MATTERMOST_URL=https://your.mattermost.instance.com
MATTERMOST_TEAM_ID=YOUR_MATTERMOST_TEAM_ID
# API token for a Mattermost service/bot account (needs permission to create
# channels, add users, read channel membership, etc.)
BOT_TOKEN=YOUR_MATTERMOST_SERVICE_ACCOUNT_TOKEN
# Only needed if you use MattermostClient's Focalboard endpoints
# (duplicate_board / create_board_from_template).
MATTERMOST_LOGIN_ID=your_mattermost_login_email_or_username
MATTERMOST_PASSWORD=your_mattermost_password

# --- Authentik (source of truth for identity / users, OIDC provider) ---
# Service API token used by clients/authentik_client.py to call the Authentik REST API.
AUTHENTIK_URL=https://your.authentik.instance.com
AUTHENTIK_TOKEN=YOUR_AUTHENTIK_API_TOKEN

# --- Outline (the only tool wired up in the V0 web app) ---
OUTLINE_URL=https://your.outline.instance.com
OUTLINE_TOKEN=YOUR_OUTLINE_API_TOKEN

# --- Brevo (reserved for a future version; not used by the web app yet) ---
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_DEFAULT_SENDER_EMAIL=noreply@example.com
BREVO_DEFAULT_SENDER_NAME=Community Manager

# --- NocoDB (used by scripts/maintenance/, not by the web app) ---
NOCODB_URL=https://your.nocodb.instance.com
NOCODB_TOKEN=YOUR_NOCODB_API_TOKEN

# --- Vaultwarden (reserved for a future version; not used by the web app yet) ---
VAULTWARDEN_ORGANIZATION_ID=YOUR_VAULTWARDEN_ORGANIZATION_ID
VAULTWARDEN_SERVER_URL=https://your.vaultwarden.instance.com
VAULTWARDEN_API_USERNAME=your_vaultwarden_api_user_email
VAULTWARDEN_API_PASSWORD=your_vaultwarden_api_user_password
# BW_PASSWORD (master password, used to unlock the CLI vault) is read directly
# from the environment by VaultwardenClient. Set it in your actual .env / secrets manager:
# BW_PASSWORD=YOUR_MASTER_PASSWORD_FOR_VAULTWARDEN_CLI_USER

# --- General ---
DEBUG=false

# =============================================================================
# Web app (backend/)
# =============================================================================

# --- Database ---
# Overridden automatically by docker-compose.yml when running via `docker compose up`
# (it points DATABASE_URL at the `db` Postgres service instead). Only used as-is
# when running the backend outside docker-compose (e.g. `uvicorn backend.main:app`).
DATABASE_URL=sqlite:///./community_manager.db
POSTGRES_USER=community_manager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=community_manager

# --- Authentication ---
# AUTH_ENABLED=false (default): OIDC login is bypassed, every request is treated
# as an authenticated admin. Convenient for local dev without an Authentik
# instance at hand. NEVER set this to false in production.
AUTH_ENABLED=false
DEV_FAKE_ADMIN_EMAIL=dev-admin@localhost

# Random long string used to sign session cookies. Generate one with e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- OIDC (only required when AUTH_ENABLED=true) ---
# Register a new OAuth2/OIDC "Provider" + "Application" in Authentik for this
# web app (distinct from AUTHENTIK_TOKEN above, which is a service API token).
OIDC_CLIENT_ID=YOUR_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_OIDC_CLIENT_SECRET
# e.g. https://your.authentik.instance.com/application/o/community-manager/.well-known/openid-configuration
OIDC_SERVER_METADATA_URL=https://your.authentik.instance.com/application/o/community-manager/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# Name of the Authentik group whose members are treated as admins of this app.
ADMIN_GROUP_NAME=community-manager-admins
